# Base URL of the VCF Operations for Logs (Aria Operations for Logs / Log
# Insight) instance. No trailing slash.
VCF_OPS_LOGS_BASE_URL=https://ops-logs.vcf.lab

# Your VCF Operations API token (the one you'd use against /suite-api).
# VCF Operations 9.1 does NOT accept this directly on log queries — the
# client exchanges it for a short-lived JWT first (see the four
# VCF_OPS_LOGS_AUTH_* vars below) and uses that JWT on actual queries.
VCF_OPS_LOGS_API_TOKEN=change-me

# Set to "false" to skip TLS certificate verification (e.g. self-signed lab certs).
VCF_OPS_LOGS_VERIFY_SSL=false

# Per-request timeout, in seconds, for calls to the VCF Operations for Logs API.
VCF_OPS_LOGS_TIMEOUT_SECONDS=30

# --- Auth: token exchange for the "ops-li" (Operations for Logs) JWT ---
# VCF_OPS_LOGS_API_TOKEN above is POSTed here as "<scheme> <token>" with
# body {"serviceKeys": [<service key>]}; the response's JWT is then sent as
# "Authorization: Bearer <jwt>" on every log query, and auto-refreshed on a 401.
VCF_OPS_LOGS_AUTH_EXCHANGE_PATH=/suite-api/api/auth/token/exchange
# "OpsToken" is the classic vROps/VCF Operations API-token scheme. If the
# exchange call itself 401s, try "Bearer" here instead.
VCF_OPS_LOGS_AUTH_HEADER_SCHEME=OpsToken
VCF_OPS_LOGS_SERVICE_KEY=ops-li

# Path (with leading slash) for the log-events query endpoint and the
# fields-listing endpoint. /api/v2/fields is an unconfirmed guess by analogy
# with /api/v2/events — adjust if list_log_fields 404s.
VCF_OPS_LOGS_EVENTS_PATH=/api/v2/events
VCF_OPS_LOGS_FIELDS_PATH=/api/v2/fields

# Host/port this MCP server itself listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DNS-rebinding protection for the Streamable HTTP transport. Off by default
# since this server is normally reached over a private network rather than
# from a browser (see pais-mcp's README for the full explanation of the "421
# Misdirected Request" error this guards against).
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# Comma-separated. Supports a ":*" port wildcard, e.g. "vcf-ops-logs-mcp.lab:*".
# MCP_ALLOWED_HOSTS=localhost:8000
# MCP_ALLOWED_ORIGINS=https://vcf-ops-logs-mcp.lab

# --- Background monitor loop ---
# Polls VCF Operations for Logs on an interval for the configured error
# terms and keeps a rolling in-memory buffer of matches, retrievable via the
# get_recent_findings tool (and visible in container logs as it happens).
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
# How far back to look on the very first poll right after startup.
MONITOR_INITIAL_LOOKBACK_MINUTES=5
# Comma-separated text terms checked every poll. One query is issued per
# term because the query API ANDs constraints together rather than ORing them.
MONITOR_ERROR_TERMS=ERROR,Exception,CRITICAL,FATAL
# Max findings kept in the in-memory rolling buffer (oldest drop off first).
MONITOR_MAX_FINDINGS=200
# Sample log lines captured per finding, for context.
MONITOR_SAMPLE_SIZE=3
# Max events fetched per term per poll.
MONITOR_QUERY_LIMIT=50
