# Base URL of the Private AI Services (PAIS) instance. No trailing slash.
PAIS_BASE_URL=https://llm-router.pse.lab

# Bearer token sent as "Authorization: Bearer <token>" on every PAIS API request.
PAIS_API_TOKEN=change-me

# Set to "false" to skip TLS certificate verification (e.g. self-signed lab certs).
PAIS_VERIFY_SSL=false

# Per-request timeout, in seconds, for calls to the PAIS API.
PAIS_TIMEOUT_SECONDS=30

# Host/port this MCP server itself listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DNS-rebinding protection for the Streamable HTTP transport. Off by default
# since this server is normally reached over a private network rather than
# from a browser. If a client gets "421 Misdirected Request" / "Invalid Host
# header" in the logs, either leave this false, or set it to true and list
# every Host/Origin clients will actually connect through below.
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# Comma-separated. Supports a ":*" port wildcard, e.g. "pais-mcp.lab:*".
# MCP_ALLOWED_HOSTS=localhost:8000,192.168.130.13:8006
# MCP_ALLOWED_ORIGINS=https://pais-mcp.lab
