# pais-mcp-web-search needs no API keys for web_search / fetch_page_content: it
# scrapes Google and DuckDuckGo result pages directly via the `ddgs` library.
# github_search_code additionally requires GITHUB_TOKEN below. All settings
# below are optional.

# Per-request timeout, in seconds, for search requests and page fetches.
WEB_SEARCH_TIMEOUT_SECONDS=10

# Set to "false" to skip TLS certificate verification (e.g. restrictive lab proxy).
WEB_SEARCH_VERIFY_SSL=true

# Optional outbound proxy for search/fetch requests, e.g. http://user:pass@host:port
# or socks5://host:port. Leave unset to connect directly.
# WEB_SEARCH_PROXY=

# User-Agent sent on page fetches (fetch_page_content tool).
WEB_SEARCH_USER_AGENT=pais-mcp-web-search/0.1 (+https://modelcontextprotocol.io)

# Default / maximum number of sources the web_search tool returns when the
# caller omits / over-requests num_results.
WEB_SEARCH_DEFAULT_NUM_RESULTS=5
WEB_SEARCH_MAX_NUM_RESULTS=20

# Default / maximum characters of extracted text returned by fetch_page_content.
WEB_SEARCH_DEFAULT_FETCH_MAX_CHARS=5000
WEB_SEARCH_MAX_FETCH_CHARS=20000

# Logging verbosity: INFO logs each search/fetch call and the sources returned;
# DEBUG additionally logs every raw scraped title/url (incl. ones later
# deduplicated) and a text preview from fetch_page_content.
WEB_SEARCH_LOG_LEVEL=INFO

# GitHub personal access token (no scopes needed for public code/repo search).
# Required for the github_search_code tool; github_search_repositories works
# without it but gets a much lower GitHub API rate limit. Create one at
# https://github.com/settings/tokens (fine-grained, read-only, public repos).
# GITHUB_TOKEN=

# Host/port this MCP server itself listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DNS-rebinding protection for the Streamable HTTP transport. Off by default
# since this server is normally reached over a private network rather than
# from a browser. If a client gets "421 Misdirected Request" / "Invalid Host
# header" in the logs, either leave this false, or set it to true and list
# every Host/Origin clients will actually connect through below.
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# Comma-separated. Supports a ":*" port wildcard, e.g. "pais-mcp-web-search.lab:*".
# MCP_ALLOWED_HOSTS=localhost:8000,192.168.130.13:8006
# MCP_ALLOWED_ORIGINS=https://pais-mcp-web-search.lab
