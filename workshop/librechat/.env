#images
LIBRECHAT_IMAGE=<librechat_image>
RAG_API_IMAGE=<rag_api_image>
MONGO_IMAGE=<mongo_image>
MEILI_IMAGE=<meili_image>

#app
HOST=0.0.0.0
PORT=3080
APP_TITLE=<app_name>
DOMAIN_CLIENT=https://localhost
DOMAIN_SERVER=https://localhost
NO_INDEX=true

#mongo
MONGO_URI=mongodb://mongodb:27017/LibreChat

#security - generated per deployment, values below are placeholders only
CREDS_KEY=<creds_key>
CREDS_IV=<creds_iv>
JWT_SECRET=<jwt_secret>
JWT_REFRESH_SECRET=<jwt_refresh_secret>

#auth
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

#search
SEARCH=true
MEILI_HOST=http://meilisearch:7700
MEILI_NO_ANALYTICS=true
MEILI_MASTER_KEY=<meili_master_key>

#rag / pgvector
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000
RAG_DB_HOST=<rag_db_host>
RAG_DB_PORT=<rag_db_port>
RAG_POSTGRES_DB=<rag_db_name>
RAG_POSTGRES_USER=<rag_db_user>
RAG_POSTGRES_PASSWORD=<rag_db_password>
